#!/bin/sh
# Lunar session launcher, started by the display manager (SDDM, GDM, ...).
#
# Starts KWin as the window manager with Lunar as the session's only shell,
# instead of KDE Plasma's plasmashell. The normal Plasma session is untouched:
# pick "Lunar" or "Plasma" at the login screen.
#
# Logs go to ~/.local/state/lunar-desktop/session.log.
set -u

log_dir=${XDG_STATE_HOME:-$HOME/.local/state}/lunar-desktop
mkdir -p "$log_dir"
exec >>"$log_dir/session.log" 2>&1
echo "=== Lunar session starting: $(date) ==="

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Lunar
# "KDE" is listed too, so KDE apps, portals and themes treat this as a KDE session.
export XDG_CURRENT_DESKTOP=Lunar:KDE
export KDE_FULL_SESSION=true
export KDE_SESSION_VERSION=6
export LUNAR_SESSION=1

# Everything below needs a D-Bus session bus. Use the one systemd already
# provides; otherwise start one for the lifetime of this session.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    if [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    elif [ -z "${LUNAR_IN_DBUS_RUN:-}" ]; then
        export LUNAR_IN_DBUS_RUN=1
        exec dbus-run-session -- "$0" "$@"
    fi
fi

if command -v kwin_wayland >/dev/null 2>&1; then
    kwin=kwin_wayland
elif command -v kwin_wayland_wrapper >/dev/null 2>&1; then
    kwin=kwin_wayland_wrapper
else
    echo "lunar-session: kwin_wayland was not found; install KWin (Plasma 6)."
    exit 1
fi

here=$(dirname -- "$(readlink -f -- "$0")")
# KWin runs lunar-session-start as its session client and quits when it ends.
exec "$kwin" --xwayland --exit-with-session="$here/lunar-session-start"
